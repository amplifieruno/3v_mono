{
  "name": "demo-video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ITAP product demo video: Playwright recordings edited by a Remotion composition",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "record": "tsx record/run.ts",
    "cameras": "tsx record/start-cameras.ts",
    "render": "remotion render src/index.ts ItapDemo out/itap-demo.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --muted",
    "render:draft": "remotion render src/index.ts ItapDemo out/draft.mp4 --scale=0.5 --muted",
    "render:light": "ffmpeg -v error -y -i out/itap-demo.mp4 -c:v libx264 -preset slow -crf 28 -pix_fmt yuv420p -movflags +faststart -an out/itap-demo-light.mp4",
    "sheet": "scripts/contact-sheet.sh out/itap-demo.mp4 out/itap-demo-sheet.png",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^20.14.10",
    "@types/react": "^19.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  }
}
