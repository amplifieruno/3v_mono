{
  "name": "demo-video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ITAP product demo video: Playwright recordings edited by a Remotion composition",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "record": "tsx record/run.ts",
    "cameras": "tsx record/start-cameras.ts",
    "render": "tsx scripts/render.ts out/itap-demo.mp4",
    "render:draft": "tsx scripts/render.ts out/draft.mp4 --scale=0.5 --crf=26",
    "render:light": "ffmpeg -v error -y -i out/itap-demo.mp4 -c:v libx264 -preset slow -crf 28 -pix_fmt yuv420p -movflags +faststart -c:a aac -b:a 128k out/itap-demo-light.mp4",
    "sheet": "scripts/contact-sheet.sh out/itap-demo.mp4 out/itap-demo-sheet.png",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "voice": "uv run voice/tts.py"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^20.14.10",
    "@types/react": "^19.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  }
}
