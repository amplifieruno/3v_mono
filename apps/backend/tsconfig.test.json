{
  // Typechecks test code (unit tests in src/ and the integration suite in tests/), which tsconfig.json excludes.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts", "vitest.integration.config.ts"],
  "exclude": ["node_modules", "dist"]
}
