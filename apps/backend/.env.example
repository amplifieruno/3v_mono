HASURA_GRAPHQL_URL=
GRAPHQL_ADMIN_SECRET=
HASURA_JWT_SECRET=
# Generate with: openssl rand -hex 32
ACTION_SECRET=
NHOST_STORAGE_URL=
SEED_PASSWORD=
ORG_TOKEN_TTL_SECONDS=900
INSIGHTFACE_API_URL=
STREAM_SERVER_URL=http://stream-server:8888
CORS_ORIGIN=
PORT=
# Seed only: the backend as the docker stack reaches it, and whether its dev webhook sink is enabled. Off by default
# (never in production); the dev compose sets it to true. The seed creates its webhook subscription to
# <BACKEND_URL>/hasura/events/webhook-sink only when true.
BACKEND_URL=http://backend:3001
WEBHOOK_SINK_ENABLED=false
# Face authentication service: must be the backend container's value (root .env.dev). The seed encrypts the demo
# client keys with it (and prints their plaintext once to the seed log — dev only); unset: no keys are seeded.
AUTH_KEY_ENCRYPTION_KEY=
